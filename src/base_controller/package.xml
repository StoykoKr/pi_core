<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>base_controller</name>
  <version>1.0.0</version>
  <description>Wheel telemetry (JointState from esp_drive) to /odom + odom->base_link TF.
    Deliberately trivial (contract: debuggable on the Pi, IMU fusion later via robot_localization).</description>
  <maintainer email="petko_ivanov_stoev@abv.bg">Petko Stoev</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

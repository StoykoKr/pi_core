# ============================================================================
# Access Point credentials — SINGLE SOURCE OF TRUTH for the robot's hotspot.
# hostapd key=value format ON PURPOSE: qr_generator.py parses exactly this
# format (RE4LIFE_HOSTAPD points here), and scripts/setup_ap.sh builds the
# NetworkManager hotspot from the same lines. One file, both consumers.
#
# install.sh copies this to ap_credentials.conf (gitignored) with a random
# passphrase on first run. Edit THAT file, not this example, then re-run:
#   bash scripts/setup_ap.sh config/ap_credentials.conf
# ============================================================================
ssid=Re4Life-Robot
wpa_passphrase=CHANGE_ME_MIN_8_CHARS
